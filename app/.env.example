# Copia este archivo como .env y ajusta los valores.

PORT=3000
NODE_ENV=development

# Cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES=7d

# Administrador inicial (se crea solo la primera vez que arranca el servidor)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=Admin123!

# Cargar productos, clientes y pedidos de demostración la primera vez (true/false)
SEED_DEMO=false

# Tamaño máximo de imágenes subidas (MB)
MAX_UPLOAD_MB=4

# Ruta de la base de datos SQLite (opcional)
# DB_FILE=./data/lubizjeans.db

# ---- Correo (SMTP) para avisos de pedidos, boletas y Libro de Reclamaciones ----
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# MAIL_FROM="Mi Tienda <tucorreo@gmail.com>"
# Otros: Outlook smtp.office365.com:587 (SMTP_SECURE=false) · Zoho smtp.zoho.com:465 · el SMTP de tu hosting.

# ---- Pasarela de pagos (cuando la conectes en src/services/payment.js) ----
# PAYMENT_PUBLIC_KEY=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
